{
    "workbench.colorTheme": "One Dark Pro Darker",
    "window.newWindowDimensions": "maximized",
    "editor.insertSpaces": false,
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 2,
    "editor.cursorBlinking": "smooth",
    "editor.renderWhitespace": "trailing",
    "editor.linkedEditing": true,
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.bracketPairColorization.enabled": true,
    "workbench.colorCustomizations": {
        "editorIndentGuide.activeBackground1": "#abb2bf",
    },
    "editor.quickSuggestions": {
        "strings": true,
        "other": true,
    },
    "editor.fontFamily": "MonoLisa, 'Fira Code', Menlo, monospace",
    "editor.fontWeight": 400,
    "editor.lineHeight": 24,
    "editor.fontLigatures": "'calt' on, 'liga' on, 'ss02' on",
    "editor.fontSize": 12,
    "workbench.iconTheme": "material-icon-theme",
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.preferences.quoteStyle": "double",
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "trailing-spaces.backgroundColor": "rgba(255, 255, 255, 0.1)",
    "trailing-spaces.borderColor": "rgba(255, 255, 255, 0.1)",
    "gitlens.hovers.currentLine.over": "line",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": true,
    "prettier.tabWidth": 4,
    "svg.preview.mode": "svg",
    "cSpell.language": "en,fr,fr-FR",
    "totalTypeScript.hideAllTips": false,
    "totalTypeScript.hideBasicTips": true,
    "totalTypeScript.hiddenTips": [
        "typeof",
        "passing-generics-to-types",
        "omit-utility-type",
        "partial-utility-type",
        "as-const",
        "record-utility-type",
        "returntype-utility-type",
        "keyof",
        "mapped-type",
        "generic-slots-in-functions",
        "remapping-in-mapped-type",
        "tuple-type",
        "pick-utility-type",
        "interface-with-generics",
        "type-alias-with-generics",
        "interface-with-multiple-generics",
        "type-alias-with-multiple-generics",
        "never-keyword",
        "as-const-on-object",
        "nonnullable-utility-type",
        "non-null-expression",
        "type-predicate",
        "exclude-utility-type",
        "conditional-type",
        "nested-conditional-type",
        "infer",
        "in-operator-narrowing",
        "required-utility-type",
        "awaited-utility-type",
    ],
    "extensions.ignoreRecommendations": true,
    "window.nativeTabs": true,
    "window.zoomLevel": -1,
    "search.exclude": {
        "package-lock.json": true,
    },
    "window.commandCenter": false,
    "workbench.startupEditor": "none",
    "git.openRepositoryInParentFolders": "never",
    "cursor.cpp.disabledLanguages": ["plaintext", "scminput"],
    "cursorpyright.analysis.typeCheckingMode": "strict",
    "workbench.layoutControl.enabled": false,
    "window.customTitleBarVisibility": "never",
    "update.mode": "silentlyApplyOnQuit",
    "task.allowAutomaticTasks": "off",
    "workbench.sideBar.location": "right",
    "workbench.secondarySideBar.showLabels": false,
    "search.mode": "newEditor",
    "js/ts.preferGoToSourceDefinition": true,
    "gitlens.advanced.messages": {
        "suppressDebugLoggingWarning": true,
    },
    "biome.suggestInstallingGlobally": false,
    "window.autoDetectColorScheme": false,
    "cursor.composer.queueMessageDefaultBehavior": "steer",
}
